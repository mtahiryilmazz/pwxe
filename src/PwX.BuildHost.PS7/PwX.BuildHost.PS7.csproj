<Project Sdk="Microsoft.NET.Sdk">
  <!-- pwx.props derleme motoru tarafindan her build icin uretilir (payload yolu, metaveri, ikon) -->
  <Import Project="pwx.props" Condition="Exists('pwx.props')" />

  <PropertyGroup>
    <PwxFramework Condition="'$(PwxFramework)'==''">net8.0</PwxFramework>
    <PwxPsSdkVersion Condition="'$(PwxPsSdkVersion)'==''">7.4.7</PwxPsSdkVersion>
    <PwxSelfContained Condition="'$(PwxSelfContained)'==''">true</PwxSelfContained>
    <PwxGui Condition="'$(PwxGui)'==''">false</PwxGui>
    <PwxUtf8 Condition="'$(PwxUtf8)'==''">true</PwxUtf8>
    <PwxNoOutput Condition="'$(PwxNoOutput)'==''">false</PwxNoOutput>
    <PwxTestHooks Condition="'$(PwxTestHooks)'==''">false</PwxTestHooks>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(PwxFramework)</TargetFramework>
    <AssemblyName>PwXApp</AssemblyName>
    <RootNamespace>PwX.BuildHost</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SelfContained>$(PwxSelfContained)</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DefineConstants Condition="'$(PwxUtf8)'=='true'">$(DefineConstants);PWX_UTF8_OUTPUT</DefineConstants>
    <DefineConstants Condition="'$(PwxNoOutput)'=='true'">$(DefineConstants);PWX_NO_OUTPUT</DefineConstants>
    <DefineConstants Condition="'$(PwxTestHooks)'=='true'">$(DefineConstants);PWX_TESTHOOKS</DefineConstants>
    <!-- Ilk surumde trimming / AOT KULLANILMAZ (Roadmap Bolum 14) -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PwxGui)'=='true'">
    <!-- GUI payloads may use Windows Forms and/or WPF. Keep console builds cross-targeted. -->
    <TargetFramework Condition="'$(PwxFramework)'=='net8.0'">net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>WinExe</OutputType>
    <DefineConstants>$(DefineConstants);PWX_GUI</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PwxIcon)'!=''">
    <ApplicationIcon>$(PwxIcon)</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PwxManifest)'!=''">
    <ApplicationManifest>$(PwxManifest)</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="$(PwxPsSdkVersion)" />
    <!-- Patched security dependencies for CVE-2024-38095 / GHSA-846f-f764-76mx and CVE-2024-43485 -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.5" />
    <EmbeddedResource Include="$(PwxPayload)" LogicalName="PwX.payload.ps1" Condition="'$(PwxPayload)'!=''" />
  </ItemGroup>
</Project>
